# Copy to .env (docker compose reads it). Never commit .env.
POSTGRES_PASSWORD=change-me

# --- Backend ---
# Use a long random value in production: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_MINUTES=720
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
# DATABASE_URL is set by docker-compose. For local runs:
# DATABASE_URL=postgresql+psycopg://tripweave:tripweave@localhost:5432/tripweave
# (default when unset: sqlite:///./tripweave.db)

# --- Routing (optional). "none" = honest straight-line estimates only. ---
ROUTING_PROVIDER=none          # none | osrm
OSRM_BASE_URL=                 # e.g. http://localhost:5000 (your own OSRM; the public demo server is not for production)
ROUTING_TIMEOUT_S=8
ROUTING_MAX_POINTS=80

# --- Currency conversion (optional). "none" keeps currencies separate. ---
FX_PROVIDER=none               # none | frankfurter
FX_BASE_URL=https://api.frankfurter.dev/v1

# --- Map tiles ---
# The default tile.openstreetmap.org is subject to the OSM tile usage policy and unsuitable for heavy production use.
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_TILE_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors
